# Primary: OpenAI direct API
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Per-role model assignment (override any to A/B test)
MODEL_RECON=gpt-5.5
MODEL_SPECIALIST=gpt-5.5-pro
MODEL_MISCONFIG=gpt-5.4
MODEL_AGGREGATOR=gpt-5.4

# Per-role reasoning effort (none, minimal, low, medium, high)
REASONING_EFFORT_RECON=medium
REASONING_EFFORT_SPECIALIST=high
REASONING_EFFORT_MISCONFIG=low
REASONING_EFFORT_REFLECTION=high
REASONING_EFFORT_AGGREGATOR=low

PORT=3000
MAX_AGENT_ITERATIONS=999
HTTP_TIMEOUT_MS=15000
SOFT_COST_WARN_USD=5
MAX_CONCURRENT_SCANS=3
SCAN_USER_AGENT=Vibehack/0.2 (internal-pentest)

# Fallback: Azure gpt-5.1 (uncomment + remove OPENAI_API_KEY to use)
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT/openai/v1
# AZURE_OPENAI_KEY=your-azure-key
# AZURE_OPENAI_DEPLOYMENT=gpt-5.1
